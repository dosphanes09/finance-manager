# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local example:  postgresql://localhost:5432/fintrack
# With creds:     postgresql://user:password@localhost:5432/fintrack
# Supabase/Neon:  copy from your project dashboard
DATABASE_URL=postgresql://localhost:5432/fintrack

# ─── Session ─────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# ─── API Server (optional) ────────────────────────────────────────────────────
# Port the Express API listens on. Defaults to 8080 if not set.
# PORT=8080

# Enable selectable-PDF parser diagnostics.
# When true, masked PDF text is saved to a temp debug file and masked line diagnostics are logged.
# PDF_PARSE_DEBUG=false

# Security controls. Defaults are suitable for local development.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# JSON_BODY_LIMIT=5mb
# URLENCODED_BODY_LIMIT=256kb
# UPLOAD_RATE_LIMIT_WINDOW_MS=60000
# UPLOAD_RATE_LIMIT_MAX=8

# ─── Frontend (set in artifacts/finance-app/.env) ─────────────────────────────
# These are read by vite.config.ts. Defaults work for local development.
# PORT=5173
# BASE_PATH=/
